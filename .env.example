# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. NEVER expose this to the browser or import it into a
# client component — it bypasses RLS entirely. Used only in webhook/cron
# route handlers and scripts that run on the server (seed, migrations).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings → Database →
# Connection string → URI). Used by Drizzle for migrations/seeding.
# Use the pooled "Transaction" connection string in serverless/edge routes;
# the direct connection is fine for local scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
