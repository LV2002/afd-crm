# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. NEVER expose this to the browser or import it into a
# client component — it bypasses RLS entirely. Used only in webhook/cron
# route handlers and scripts that run on the server (seed, migrations).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings → Database →
# Connection string → URI). Used by Drizzle for migrations/seeding.
# Use the pooled "Transaction" connection string in serverless/edge routes;
# the direct connection is fine for local scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set
# this to anything random; it's never typed in by a human, just compared.
CRON_SECRET=

# Encrypts every credential an admin enters under Settings → Integrations
# (Meta, Google, WhatsApp, telephony) at rest — see
# src/lib/integrations/credentials.ts. Generate with `openssl rand -base64 32`.
# Unlike everything else under Settings, this one env var genuinely can't be
# a database row (it's what the database rows are encrypted under), so it's
# the one piece of "plug and play" integration setup that needs a deploy,
# not a form.
INTEGRATION_ENCRYPTION_KEY=

# ── Email ────────────────────────────────────────────────────────────
# Sending is off until both of these are set; nothing breaks without
# them, notifications simply stay in-app only.
#
# Deliberately environment variables rather than the encrypted
# integration_credentials table every other integration uses: this is the
# channel that tells you the DATABASE is down, and a mail client that has
# to read the database first cannot report the failure it exists for.
RESEND_API_KEY=
EMAIL_FROM="AFD India CRM <crm@yourdomain.com>"

# Who hears when something breaks. Comma-separated.
ALERT_EMAIL_TO=

# Used for the links inside emails. Vercel sets VERCEL_URL itself, but a
# custom domain needs this.
NEXT_PUBLIC_APP_URL=
