{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/frequent",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/hourly",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "30 4 * * *"
    }
  ]
}
